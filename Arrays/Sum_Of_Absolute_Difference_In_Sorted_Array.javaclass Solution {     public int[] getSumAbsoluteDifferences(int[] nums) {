class Solution {
    public int[] getSumAbsoluteDifferences(int[] nums) {
      int n = nums.length;
      int[] ans =  new int[n];
      int totalSum = 0;
      for(int i:nums)
        {
          totalSum += i;
        }
      int leftSum = 0;
      for(int i=0;i<n;i++)
        {
          int rightSum = totalSum - leftSum - nums[i];
          ans[i] = (nums[i]*i - leftSum) + (rightSum - (n-i-1)*nums[i]);
          leftSum[i] += nums[i];
        }
      return ans;
    }
}
